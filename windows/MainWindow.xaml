<Window x:Class="RemoteMac.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Remote Mac">
    <Grid x:Name="Root">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F9" Invoked="FullscreenShortcut"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <CommandBar x:Name="Toolbar" DefaultLabelPosition="Right">
            <AppBarButton Label="Mirror" Click="MirrorClicked"/>
            <AppBarButton Label="Extend" Click="ExtendClicked"/>
            <AppBarButton Label="Primary" Click="PrimaryClicked"/>
            <AppBarSeparator/>
            <AppBarButton Label="Fullscreen" Click="FullscreenClicked"/>
            <AppBarButton Label="Release input" Click="ReleaseClicked"/>
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Send clipboard" Click="SendClipboardClicked"/>
                <AppBarButton Label="Get clipboard" Click="GetClipboardClicked"/>
                <AppBarButton Label="Key mapping" Click="MappingClicked"/>
                <AppBarButton Label="Disconnect" Click="DisconnectClicked"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <Grid Grid.Row="1">
            <Grid x:Name="SessionSurface" Background="Black" Visibility="Collapsed">
                <MediaPlayerElement x:Name="Video" Stretch="Uniform" AreTransportControlsEnabled="False" IsHitTestVisible="False"/>
                <ContentControl x:Name="InputSurface" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="Transparent" BorderThickness="0" Padding="0" TabIndex="0" IsTabStop="True"
                        AutomationProperties.Name="Remote desktop input"
                        KeyDown="InputKeyDown" KeyUp="InputKeyUp" LostFocus="InputLostFocus"
                        PointerPressed="InputPressed" PointerReleased="InputReleased"
                        PointerMoved="InputMoved" PointerWheelChanged="InputScrolled"
                        PointerCaptureLost="InputCaptureLost">
                    <ContentControl.Template>
                        <ControlTemplate TargetType="ContentControl">
                            <Border Background="{TemplateBinding Background}"/>
                        </ControlTemplate>
                    </ContentControl.Template>
                </ContentControl>
            </Grid>
            <Button x:Name="ExitFullscreen" Content="Exit fullscreen" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                    Click="FullscreenClicked"/>
            <StackPanel x:Name="Setup" MaxWidth="460" Spacing="12" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Connect to your Mac" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBox x:Name="Address" Header="Mac LAN address"/>
                <TextBox x:Name="Fingerprint" Header="Mac certificate fingerprint"/>
                <PasswordBox x:Name="PairingKey" Header="Pairing key" PlaceholderText="Leave empty to use a saved pairing"/>
                <Button x:Name="ConnectButton" Content="Connect" Click="ConnectClicked"/>
                <TextBlock x:Name="Status" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
